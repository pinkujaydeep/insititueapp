# Copy to .env.local (local dev: run `npm run sb:env` from the repo root to generate it).
# Production: set these in Vercel / Cloudflare Pages project settings.
#
# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
# The PUBLIC anon (or "publishable") key. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=
