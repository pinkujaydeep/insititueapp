{
  "name": "institute-app",
  "private": true,
  "type": "module",
  "scripts": {
    "sb:start": "supabase start",
    "sb:stop": "supabase stop",
    "sb:reset": "supabase db reset",
    "sb:env": "node scripts/write-local-env.mjs",
    "create-super-admin": "node scripts/create-super-admin.mjs",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "test": "npm run test:db && npm run test:unit",
    "test:db": "vitest run --config tests/vitest.config.ts",
    "test:unit": "npm --prefix client run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1",
    "supabase": "^2.122.0",
    "vitest": "^5.0.5"
  }
}
